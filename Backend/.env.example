# Copy this file to Backend/.env and add your Supabase project values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Gmail SMTP sender. Use a Google App Password, never the normal account password.
ADITI_EMAIL=aditi.manageyourwealth@gmail.com
ADITI_EMAIL_PASSWORD=your-16-character-google-app-password
ADITI_SENDER_NAME=ADITI Updates

# Weekly schedule: cron format "minute hour day-of-month month day-of-week".
# Default: 9:00 AM every Monday in India.
EMAIL_DIGEST_ENABLED=true
EMAIL_DIGEST_TIMEZONE=Asia/Kolkata
EMAIL_DIGEST_CRON=0 9 * * 1

# Optional AI configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
